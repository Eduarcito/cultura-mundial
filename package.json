{
  "name": "cultura-sin-fronteras",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,yellow \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:remove-demo": "npm run db:remove-demo -w backend",
    "admin:create": "npm run admin:create -w backend",
    "db:local:start": "npm run db:local:start -w backend",
    "db:local:stop": "npm run db:local:stop -w backend",
    "test": "npm test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

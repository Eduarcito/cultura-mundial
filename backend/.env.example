NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://cultura:change-me@localhost:5432/cultura
SESSION_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
# Producción: HTTPS, NODE_ENV=production y TRUST_PROXY=1 solo detrás de un proxy confiable.
TRUST_PROXY=0
# Base separada y desechable. El nombre debe terminar en _test.
TEST_DATABASE_URL=postgres://cultura:change-me@localhost:5432/cultura_test
# Solo se usan al ejecutar npm run admin:create; no se crea un administrador por defecto.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administración
# Opcional: solo para iniciar/detener una instancia propia ya inicializada con initdb.
LOCAL_PG_BIN=
LOCAL_PG_DATA=
